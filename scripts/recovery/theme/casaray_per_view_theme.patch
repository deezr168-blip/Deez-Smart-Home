index 8b541b7..22a1b12 100644
--- a/dashboards/casaray_v2.yaml
+++ b/dashboards/casaray_v2.yaml
@@ -36,6 +36,8 @@
 # /config/themes/ and themes reloaded, or this falls back to the user's
