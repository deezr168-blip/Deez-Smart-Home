# ==========================================================================
# Home Assistant /config — deployment branch (ha-deploy)
#
# The root of this branch IS /config. Everything below must NEVER be
# committed here: it is either secret, machine-local, or regenerated by
# Home Assistant itself.
# ==========================================================================

# --- Secrets -------------------------------------------------------------
secrets.yaml
**/secrets.yaml
*secret*
*credential*
*password*
.env
.env.*
!.env.example

# --- Home Assistant internal state / auth --------------------------------
.storage/
**/.storage/
.cloud/
.HA_VERSION
.uuid
auth_provider.*
ip_bans.yaml

# --- Databases (recorder / history) --------------------------------------
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
home-assistant_v2.db*

# --- Logs ----------------------------------------------------------------
*.log
*.log.*
*.log.fault
home-assistant.log*
OZW_Log.txt

# --- Backups / snapshots -------------------------------------------------
backups/
snapshots/
tts/
*.tar
*.tar.gz
*.tgz
*.zip

# --- Keys, certificates, tokens ------------------------------------------
*.pem
*.key
*.crt
*.p12
*.pfx
*.token
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
known_hosts
authorized_keys

# --- Integration state that is machine-local -----------------------------
.google.token
google_calendars.yaml
zigbee.db*
zwcfg_*.xml
zwave_migration.pickle
deps/
custom_components/*/__pycache__/

# --- Caches / OS / editor cruft ------------------------------------------
__pycache__/
*.pyc
.DS_Store
Thumbs.db
*.tmp
*.swp
*~
.vscode/
.idea/

# Deployment credentials — see DEPLOY_AUTH.md. These live on the Home Assistant
# host under /config and must never be tracked. Listed here as a second line of
# defence in case the clone path and the repo root ever coincide.
.deez_deploy.env
*deploy*.env
.deez_gitconfig
.git-credentials
.ssh/
deploy_askpass_local.sh
